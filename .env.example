# ── ZKTeco C3 Middleware configuration ──────────────────────────────────────
# Copy to .env and adjust. Real environment variables always override .env.
# Nothing is hardcoded in the binary; every setting below has a safe default
# except PANEL_ADDR, which is required.

# ── Panel ───────────────────────────────────────────────────────────────────
# host:port of the C3 access panel (REQUIRED). On the dev box this is reached
# through the Windows portproxy at 172.17.224.1:4370; on the Linux server it is
# the panel's real LAN address, e.g. 192.168.0.102:4370.
PANEL_ADDR=192.168.0.102:4370
# Logical id for this panel (labels events, logs, metrics).
PANEL_ID=panel-1
# Per-command panel I/O timeout (Go duration or bare seconds).
IO_TIMEOUT=5s

# ── Resilience (reconnect backoff) ──────────────────────────────────────────
RECONNECT_MIN=1s
RECONNECT_MAX=30s

# ── HTTP API ────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

# ── Behavior ────────────────────────────────────────────────────────────────
# Default lock-relay pulse duration when a door-open request omits "seconds".
DOOR_DEFAULT_SECONDS=5
# Per-subscriber SSE buffer (events dropped for a subscriber slower than this).
EVENT_BUFFER_SIZE=64
# How often the realtime log is polled for new events.
EVENT_POLL_INTERVAL=1s
# Emit the panel's buffered events once on connect (backfill). Default false.
EVENT_REPLAY_BACKLOG=false

# ── Data-table writes (enroll/revoke/rules) ─────────────────────────────────
# OFF by default. Writing to a live access panel is gated behind explicit
# opt-in. The write wire-format is implemented but NOT yet hardware-validated;
# validate once before relying on it in production.
ALLOW_WRITES=false

# ── Middleware-driven access (turnstile / auto-open) ────────────────────────
# When enabled, a card read at a reader opens the mapped door from the
# middleware (panel still makes its own local decision independently).
AUTO_OPEN_ENABLED=false
# Pulse duration for auto-open (defaults to DOOR_DEFAULT_SECONDS).
AUTO_OPEN_SECONDS=5
# Card numbers allowed to auto-open, comma-separated. "*" = any card (test only).
AUTO_OPEN_CARDS=
# Reader/eventaddr -> door map, e.g. "1:1,2:1,3:2,4:2". Empty = reader N -> door N.
# For a bidirectional turnstile, wire each direction to a separate door relay.
READER_DOOR_MAP=

# ── Audit log ───────────────────────────────────────────────────────────────
# Append-only JSONL file of every access event (for /events/history + audit).
# Empty = in-memory only.
AUDIT_LOG_PATH=events.jsonl
# In-memory history buffer size (rows queryable via /events/history).
AUDIT_RING_SIZE=10000

# ── Security ────────────────────────────────────────────────────────────────
# Bearer token required on all endpoints except /healthz. Empty = auth disabled
# (dev only). Generate with:  openssl rand -hex 32
API_KEY=
# Comma-separated allowed CORS origins for a browser frontend. "*" allows all.
# Empty disables CORS entirely.
CORS_ORIGINS=
# Honor X-Forwarded-* when behind a trusted reverse proxy.
TRUSTED_PROXY=false

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info      # debug | info | warn | error
LOG_FORMAT=json     # json | text

# Path to this env file (rarely changed).
# ENV_FILE=.env
